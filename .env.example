# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin panel password (/admin/login)
ADMIN_PASSWORD=change-me

# Optional: cron keep-alive for Supabase
CRON_SECRET=

# Optional: Supabase (concerts, contact inbox). Site renders without these.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Resend (booking form emails). Form returns backend error without this.
RESEND_API_KEY=
RESEND_FROM=
RESEND_TO=

# Optional: override contact phone
# CONTACT_PHONE=888704363
# NEXT_PUBLIC_CONTACT_PHONE=888704363

# Optional: embed URLs
# NEXT_PUBLIC_SPOTIFY_EMBED_URL=
# NEXT_PUBLIC_YOUTUBE_EMBED_URL=
