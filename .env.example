# Public site URL (no trailing slash). Production must use www:
# NEXT_PUBLIC_SITE_URL=https://www.themedievals.pl
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin panel password (/admin/login) — use 10+ chars; weak passwords blocked in production
ADMIN_PASSWORD=change-me-to-a-long-secret
# Optional separate signing key for the admin cookie
# ADMIN_SESSION_SECRET=
# Optional comma-separated IP allowlist for /admin (empty = any IP)
# ADMIN_ALLOWED_IPS=1.2.3.4,5.6.7.8

# Required for /api/cron/keep-alive (Vercel Cron + optional GitHub Action)
# Use a long random string; also set the same value as GitHub secret CRON_SECRET
CRON_SECRET=

# Optional: Supabase (contact inbox + admin archive). Site renders without these.
# Project: https://tdqvmlieqidporwhuiwz.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://tdqvmlieqidporwhuiwz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Resend (booking form emails). Form returns backend error without this.
RESEND_API_KEY=
RESEND_FROM=
RESEND_TO=

# Optional: override contact phone
# CONTACT_PHONE=888704363
# NEXT_PUBLIC_CONTACT_PHONE=888704363

# Optional: Spotify embed URL
# NEXT_PUBLIC_SPOTIFY_EMBED_URL=

# Optional: Google Search Console HTML-tag verification
GOOGLE_SITE_VERIFICATION=


